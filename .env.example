# MongoDB 접속 주소
# - Atlas 사용 시:   mongodb+srv://아이디:비번@cluster0.xxxxx.mongodb.net/dubco?retryWrites=true&w=majority
# - Cloudtype MongoDB: mongodb://root:비번@db내부호스트:27017/dubco?authSource=admin
MONGODB_URI=mongodb+srv://아이디:비번@cluster0.xxxxx.mongodb.net/dubco?retryWrites=true&w=majority

# iron-session 쿠키 암호화 키 (랜덤 32자 이상)
SESSION_SECRET=change_me_to_a_random_string_at_least_32_chars

# 시드 관리자 계정 (scripts/seed.ts 에서 사용)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin1234

NODE_ENV=production
TZ=Asia/Seoul
